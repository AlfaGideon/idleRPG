{
  "name": "idle-rpg-corona-i-klinok",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Корона и Клинок — средневековая мобильная idle RPG (PWA)",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/prepare-emoji.mjs",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "build:apk": "bash android/build-apk.sh"
  },
  "devDependencies": {
    "@twemoji/svg": "^15.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.1.0",
    "@fontsource/cormorant-garamond": "^5.3.0"
  }
}
